{
  "manifest_version": 3,
  "name": "Board Coach",
  "version": "2.7.3",
  "description": "Board Coach for Chess.com and Lichess: move suggestions, instant verdict in games and free, unlimited game reviews.",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://lichess.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://lichess.org/*"
      ],
      "js": [
        "lib/chess.js",
        "content/tcn.js",
        "content/analysis.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Board Coach",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116",
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": false
  }
}